{
    "name": "inpsyde/modularity",
    "type": "library",
    "description": "Modular PSR-11 implementation for WordPress plugins, themes or libraries.",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Syde GmbH",
            "email": "hello@syde.com",
            "homepage": "https://syde.com/",
            "role": "Company"
        }
    ],
    "repositories": [
        {
            "type": "composer",
            "url": "https://repo.packagist.com/inpsyde/"
        },
        {
            "packagist.org": false
        },
        {
            "type": "composer",
            "url": "https://raw.githubusercontent.com/inpsyde/wp-stubs/main",
            "only": [
                "inpsyde/wp-stubs-versions"
            ]
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "psr/container": "^1.1.0 || ^2"
    },
    "require-dev": {
        "brain/monkey": "^2.6.1",
        "inpsyde/wp-stubs-versions": "6.7",
        "mikey179/vfsstream": "^v1.6.11",
        "phpstan/phpstan": "^2.1.1",
        "phpstan/phpstan-deprecation-rules": "^2.0.1",
        "phpstan/phpstan-mockery": "^2.0.0",
        "phpstan/phpstan-phpunit": "^2.0.4",
        "phpunit/phpunit": "^9.6.19",
        "swissspidy/phpstan-no-private": "^v1.0.0",
        "syde/phpcs": "^1.0.0",
        "roots/wordpress": ">=7.0",
        "syde/wp-phpunit-integration": "^0.4"
    },
    "extra": {
        "wordpress-install-dir": "vendor/wordpress/wordpress",
        "installer-paths": {
            "vendor/wordpress/wordpress/wp-content/themes/{$name}": [
                "type:wordpress-theme"
            ],
            "vendor/wordpress/wordpress/wp-content/plugins/{$name}": [
                "type:wordpress-plugin"
            ],
            "vendor/wordpress/wordpress/wp-content/mu-plugins/{$name}": [
                "type:wordpress-muplugin"
            ]
        },
        "branch-alias": {
            "dev-master": "1.x-dev"
        }
    },
    "autoload": {
        "psr-4": {
            "Syde\\Modularity\\": "src/"
        },
        "files": [
            "inc/class-alias.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Syde\\Modularity\\Tests\\": "tests/src/",
            "Syde\\Modularity\\Tests\\Unit\\": "tests/unit/",
            "Syde\\Modularity\\Tests\\Integration\\": "tests/integration/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "phpcs": "@php ./vendor/squizlabs/php_codesniffer/bin/phpcs",
        "phpstan": "@php ./vendor/bin/phpstan analyse --memory-limit=1G",
        "tests:integration": "@php ./vendor/phpunit/phpunit/phpunit --testsuite=integration --no-coverage -c phpunit-integration.xml.dist",
        "tests:unit:cov": "@php ./vendor/phpunit/phpunit/phpunit --testsuite=unit",
        "tests:unit": "@php ./vendor/phpunit/phpunit/phpunit --testsuite=unit --no-coverage",
        "tests": [
            "@tests:integration",
            "@tests:unit"
        ],
        "tests:cov": [
            "@tests:integration",
            "@tests:unit:cov"
        ],
        "qa": [
            "@phpcs",
            "@phpstan"
        ]
    },
    "config": {
        "allow-plugins": {
            "composer/*": true,
            "inpsyde/*": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "roots/wordpress-core-installer": true
        },
        "sort-packages": true
    }
}
